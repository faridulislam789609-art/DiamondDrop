rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Allow reading user profiles for authenticated users (and admin)
      allow read: if isAuthenticated();

      // Allow creating user document on first login - must always have role 'user'
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.uid == userId;

      // Allow updating own profile (forbidding role escalation) OR admin
      allow update: if (isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || request.resource.data.role == resource.data.role))
        || isAdmin();

      // Disallow client deletions
      allow delete: if false;

      // Activity subcollection
      match /activity/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Weekly round collection (public read so unauthenticated and authenticated users see campaign & timers)
    match /weeklyRounds/{roundId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Winners subcollection (public read so all participants can verify winners ledger)
      match /winners/{winnerId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isOwner(winnerId) && request.resource.data.rewardStatus in ['request_submitted', 'pending']);
      }
    }

    // Reward requests collection
    match /rewardRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}

